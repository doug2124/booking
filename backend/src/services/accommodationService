const accommodationRepository=require("../repositories/accommodationRepository");

const getAccommodation=async()=>{
    return await accommodationRepository.getAccommodation();
};

const getAccommodationById=async(id)=>{
    return await accommodationRepository.getAccommodationById(id)
};

const createAccommodation=async(data)=>{
    return await accommodationRepository.createAccommodation(data);
};

const deleteAccommodation=async(id)=>{
    return await accommodationRepository.deleteAccommodation(id);
}

const updateAccommodation=async(id,data)=>{
    return accommodationRepository.updateAccommodation(id,data);
}

module.exports={
    getAccommodation,
    getAccommodationById,
    createAccommodation,
    deleteAccommodation,
    updateAccommodation
};